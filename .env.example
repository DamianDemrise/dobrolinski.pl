# Strona (Nuxt). Adres endpointu jest jawny, to nie sekret.
# Pusty = formularz oferty się nie renderuje.
NUXT_PUBLIC_OFFER_ENDPOINT=

# Sekrety endpointu NIE trafiają tutaj ani do repo:
# offer-worker/.dev.vars lokalnie, `wrangler secret put` produkcyjnie.
# Lista zmiennych: offer-worker/.dev.vars.example
