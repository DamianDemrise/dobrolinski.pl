{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": false,
    "paths": { "@demrise/cms-core": ["../packages/cms-core/src/index.ts"] }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
