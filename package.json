{
  "name": "dobrolinski-pl",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "cms:tokens": "node scripts/cms-tokens.mjs",
    "cms:pull": "node scripts/cms-pull.mjs",
    "cms:build": "CMS_ADMIN=1 nuxt generate && node vendor/demrise-cms/scripts/cms-build-admin.mjs",
    "test:regression": "nuxt generate && node scripts/regression-html.mjs",
    "preview": "nuxt preview",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck && CMS_ADMIN=1 nuxt typecheck",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run typecheck:worker && npm run typecheck:cms && npm run test",
    "typecheck:worker": "tsc -p offer-worker",
    "offer:dev": "node offer-worker/scripts/dev-server.ts",
    "offer:preview": "node offer-worker/scripts/preview-email.ts",
    "typecheck:cms": "tsc -p vendor/demrise-cms/core && tsc -p vendor/demrise-cms/worker && tsc -p cms-worker",
    "cms:seed": "node cms-worker/scripts/seed.mjs",
    "cms:migrate:local": "cd cms-worker && wrangler d1 migrations apply dobrolinski-cms --local",
    "cms:dev": "cd cms-worker && wrangler dev --local --port 8787"
  },
  "dependencies": {
    "nuxt": "4.5.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.12.0",
    "happy-dom": "20.14.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.12"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
